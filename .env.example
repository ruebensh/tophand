# ─────────────────────────────────────────────────────────────────────────────
# TopHand environment template — copy to `.env` and fill real values.
# NEVER commit `.env`. NEVER put real secrets in this file.
# ─────────────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# TopHand Core Config
# JWT_SECRET: REQUIRED in any internet-exposed environment (auth fails fast
# without it). Also used as the fallback HMAC key for verification-media signed
# URLs when VERIFICATION_MEDIA_SECRET is not set.
JWT_SECRET=
PORT=

# LOCAL_DEV: Set to `1` ONLY on a developer machine. This is the single switch
# that enables insecure conveniences (demo/dev auth bypass, loose startup,
# Vite dev-server integration). Without `LOCAL_DEV=1`, NODE_ENV alone NEVER
# enables insecure behaviour (P1-3 fail-closed).
LOCAL_DEV=

# PostgreSQL Database (Neon.tech - Serverless Postgres)
DATABASE_URL=
# DB_SSL_REJECT_UNAUTHORIZED: set `false` only if your provider's CA chain
# fails strict verification (exposed envs should keep the default).
DB_SSL_REJECT_UNAUTHORIZED=

# Admin Login Credentials (email + bcrypt-hashed password)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Google OAuth Client ID (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Telegram bot (login widget)
TELEGRAM_BOT_TOKEN=

# ─── Cloudflare R2 Object Storage ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Public bucket — regular listing/media uploads.
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# P1-1: PRIVATE bucket for verification documents (passport/selfie).
# Recommended: a separate bucket with NO public read / no CDN mapping.
# Falls back to R2_BUCKET_NAME when unset (objects still get private,
# no-store Cache-Control — but a dedicated bucket is strongly preferred).
R2_PRIVATE_BUCKET_NAME=

# P1-1/P2-1: HMAC key for short-lived signed verification-media URLs.
# REQUIRED-optional: if unset, JWT_SECRET is used. If neither is present,
# media signing is DISABLED fail-closed (signed preview links are not issued).
# Use a dedicated random secret >= 16 chars, e.g. `openssl rand -hex 32`.
VERIFICATION_MEDIA_SECRET=

# Google Search Console / SEO canonical URL (apex→www: canonical = www)
SITE_URL=

# ─── Brevo SMTP (transactional email — verification codes) ───────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Brevo HTTP API (preferred over SMTP — reliable on Render; port 443) ─────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─── Machine translation (MT) for listings/reviews/orgs (ru/en) ──────────────
# Google Cloud Translation API v2 key. Empty = MT disabled (content stays
# in source language).
GOOGLE_TRANSLATE_API_KEY=
